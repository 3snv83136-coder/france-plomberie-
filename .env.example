# =====================================================
# Site
# =====================================================
NEXT_PUBLIC_SITE_URL=https://artisans-pres-de-chez-vous.fr
NEXT_PUBLIC_SITE_NAME="Artisans Près De Chez Vous"

# =====================================================
# Supabase (optional)
# =====================================================
# If left empty, the app falls back to seed data and the lead API
# returns 202 Accepted without persisting (graceful degradation).
#
# To wire up Supabase:
#   1. Create a project at https://supabase.com
#   2. Copy the URL and anon key from Project Settings → API
#   3. Copy the service_role key (server-only, KEEP SECRET)
#   4. Apply migrations: see supabase/migrations/*.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
