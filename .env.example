# =====================================================
# Site
# =====================================================
NEXT_PUBLIC_SITE_URL=https://artisans-pres-de-chez-vous.fr
NEXT_PUBLIC_SITE_NAME="Artisans Près De Chez Vous"

# =====================================================
# Email notifications (Resend)
# =====================================================
# Crée un compte gratuit sur https://resend.com (3 000 mails/mois gratuits).
# Récupère ta clé API dans Settings → API Keys.
#
# RESEND_API_KEY        — clé API Resend (server-only, format re_xxx).
# NOTIFY_EMAIL_TO       — adresse(s) qui reçoit les leads. Plusieurs séparées par des virgules.
# NOTIFY_EMAIL_FROM     — adresse expéditrice. Par défaut, "onboarding@resend.dev"
#                         fonctionne sans configuration. Pour un domaine custom,
#                         vérifie ton domaine dans Resend puis utilise
#                         "Artisans Près De Chez Vous <leads@tondomaine.fr>".
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM="Artisans Près De Chez Vous <onboarding@resend.dev>"

# =====================================================
# Cron (Vercel)
# =====================================================
# Secret pour authentifier le cron Vercel qui génère un article
# automatiquement toutes les 12 heures sur /api/cron/generate-news.
# Genère une chaîne aléatoire forte (32+ caractères). Vercel l'envoie
# dans l'header Authorization: Bearer <SECRET>.
#
# Si non défini, le endpoint accepte les requêtes internes Vercel
# (header x-vercel-cron) mais rejette les appels externes — c'est
# normalement suffisant en production.
CRON_SECRET=

# =====================================================
# Supabase (optional)
# =====================================================
# If left empty, the app falls back to seed data and the lead API
# returns 202 Accepted without persisting (graceful degradation).
#
# To wire up Supabase:
#   1. Create a project at https://supabase.com
#   2. Copy the URL and anon key from Project Settings → API
#   3. Copy the service_role key (server-only, KEEP SECRET)
#   4. Apply migrations: see supabase/migrations/*.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
